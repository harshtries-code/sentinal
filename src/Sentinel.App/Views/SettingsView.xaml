<UserControl x:Class="Sentinel.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Page header (boards 09–11). -->
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Customize how Sentinel scans, protects, and works on this PC."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,14"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Section rail (board 09 left nav). -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
                <ListBox x:Name="SectionNav" SelectionChanged="SectionNav_SelectionChanged" SelectedIndex="0"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Settings sections">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="MinHeight" Value="42"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem AutomationProperties.Name="Scanning settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanning" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="AI and permissions settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSparkle}" Style="{StaticResource IconPath}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            <TextBlock Text="AI &amp; permissions" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Privacy settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLock}" Style="{StaticResource IconPath}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            <TextBlock Text="Privacy" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Actions and safety settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPath}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            <TextBlock Text="Actions &amp; safety" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Appearance and accessibility settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMonitor}" Style="{StaticResource IconPath}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            <TextBlock Text="Appearance &amp; accessibility" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="About and data settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                            <TextBlock Text="About &amp; data" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Section content (board 09 rows). -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel x:Name="SectionScanning">
                        <TextBlock Text="Scanning" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Configure how Sentinel scans your device, and when."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Default mode" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Sets the default scanning mode for scheduled and manual scans." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding ScanModes}" SelectedItem="{Binding DefaultScanMode}" Width="150"
                                          AutomationProperties.Name="Default scan mode setting"/>
                                <TextBlock Text="Turbo is manual-only." FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Balanced CPU limit" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Limits CPU usage during scans in Balanced mode." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="10%" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Slider Value="{Binding BalancedCapPercent}" Minimum="10" Maximum="30" Width="170" Margin="8,0"
                                        VerticalAlignment="Center" TickFrequency="5" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Balanced CPU limit"/>
                                <TextBlock Text="30%" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                                    <Run Text="{Binding BalancedCapPercent, Mode=OneWay}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Eco ≤ 15%, Balanced 25%, Turbo ≤ 60% (manual-only)." FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-8,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Pause below 20% battery" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Automatically pause scans when battery level is below 20%." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PauseOnLowBattery}"
                                      VerticalAlignment="Center" AutomationProperties.Name="Pause scans on low battery setting"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Priority watch" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Check new and running processes while the app is open." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PriorityWatchEnabled}"
                                      VerticalAlignment="Center" AutomationProperties.Name="Priority watch setting"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SectionAi" Visibility="Collapsed">
                        <TextBlock Text="AI &amp; permissions" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="The cloud model investigates read-only. It never deletes, moves, or repairs files."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="AI layer enabled" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Investigations and the Ask panel use the cloud model." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AiEnabled}"
                                      VerticalAlignment="Center" AutomationProperties.Name="AI layer setting"/>
                        </Grid>
                        <TextBlock Text="{Binding CloudKeyLine}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CloudKeyFormatHint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <PasswordBox x:Name="KeyBox" Width="300" VerticalAlignment="Center"/>
                            <Button Content="Save key" Click="SaveKey_Click" Margin="8,0,0,0" Padding="12,6"/>
                            <Button Content="Remove" Click="RemoveKey_Click" Margin="8,0,0,0" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding KeyError}" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="Never Touch folders" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="The cleaner never lists these folders." FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding NeverTouch}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                            Background="{DynamicResource SurfaceRaisedBrush}" Padding="10,7" Margin="0,0,0,5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Padding="9,3"
                                                    Command="{Binding DataContext.RemoveNeverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBox Text="{Binding NewNeverPath, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,8,0"/>
                            <Button Content="Add folder" Command="{Binding AddNeverCommand}" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NeverError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel x:Name="SectionPrivacy" Visibility="Collapsed">
                        <TextBlock Text="Privacy" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Exactly what leaves this PC, and what never does."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Show AI payload inspector" Command="{Binding ShowPayloadsCommand}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Clear scan cache" Command="{Binding DeleteDataCommand}" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PayloadCapacityLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding PayloadRows}" SelectedItem="{Binding SelectedPayloadRow, Mode=TwoWay}"
                                 DisplayMemberPath="Summary" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 MaxHeight="110" Margin="0,0,0,4" AutomationProperties.Name="Captured AI requests"/>
                        <TextBlock Text="{Binding PayloadDetail}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" MaxHeight="160" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CrashDataPolicy}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TelemetryPolicy}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActionNote}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel x:Name="SectionSafety" Visibility="Collapsed">
                        <TextBlock Text="Actions &amp; safety" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Locked rails: these rules cannot be changed in Settings."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,16"/>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUndo}" Style="{StaticResource IconPath}"
                                      Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                <TextBlock Text="{Binding RestorePolicy}" FontSize="12.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLock}" Style="{StaticResource IconPath}"
                                      Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                <TextBlock Text="{Binding DeletionPolicy}" FontSize="12.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SectionAppearance" Visibility="Collapsed">
                        <TextBlock Text="Appearance &amp; accessibility" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Theme, text size, and motion."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Dark, light, or follow Windows. High contrast stays available." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Theme"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Font size" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Scales text across the app (90–125%)." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Value="{Binding FontPercent}" Minimum="90" Maximum="125" Width="170"
                                        VerticalAlignment="Center" TickFrequency="5" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Font size"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                                    <Run Text="{Binding FontPercent, Mode=OneWay}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Reduce motion" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Suppresses transitions." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReduceMotion}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Reduce motion setting"
                                      ToolTip="Suppresses transitions. Sentinel currently has no animated transitions; this setting holds for any added later."/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="High contrast" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Switches to the dedicated high-contrast resource set." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HighContrast}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="High contrast setting"
                                      ToolTip="Switches to the dedicated high-contrast resource set."/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                        <TextBlock Text="About &amp; data" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Version, model, and where your data lives."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Export audit JSON" Click="ExportJson_Click" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="Export audit HTML" Click="ExportHtml_Click" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="App "/> <Run Text="{Binding AppVersion, Mode=OneWay}"/> <Run Text=" · model: "/> <Run Text="{Binding ModelInfo, Mode=OneWay}"/> <Run Text=" · pack v"/><Run Text="{Binding PackVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding DataInfo}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Text="Settings saved automatically." FontSize="12" HorizontalAlignment="Right" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
