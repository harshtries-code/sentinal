<Window x:Class="Sentinel.App.Views.DriverSheetWindow" Style="{StaticResource SentinelWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm driver action" Height="620" Width="680"
        MinHeight="480" MinWidth="560"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- D43: the last human gate for driver changes. Confirm
                 approves exactly the listed devices and versions. -->
            <TextBlock Text="{Binding ActionTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CountLine}" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding AsOfLine}" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- Preview state -->
            <StackPanel Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="These devices will change:"
                           FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ListBox ItemsSource="{Binding Included}" MaxHeight="180"
                         AutomationProperties.Name="Devices to change">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ChangeLine}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SourceLine}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DetailLine}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox ItemsSource="{Binding Unsupported}" MaxHeight="110" Margin="0,6,0,0"
                         Visibility="{Binding HasUnsupported, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="Devices without an update">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding OemNote}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasOemNote, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding BackupLine}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PermissionLine}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ElevationLine}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RestartLine}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LimitationsLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding RefusedReason}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="IndianRed"
                           Visibility="{Binding IsRefusedPreview, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Confirm — change these devices"
                            Command="{Binding ConfirmCommand}" Padding="12,6" Margin="0,0,8,0"
                            IsDefault="True"
                            AutomationProperties.Name="Confirm driver action"/>
                    <Button Content="Cancel" Command="{Binding CloseCommand}" Padding="12,6"
                            IsCancel="True"
                            AutomationProperties.Name="Cancel driver action"/>
                </StackPanel>
            </StackPanel>

            <!-- Running state -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Working — every device is re-checked before it changes:"
                           FontWeight="SemiBold"/>
                <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}" Height="18" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding ProgressText}" Margin="0,4,0,0"/>
                <Button Content="Cancel" Command="{Binding CancelRunCommand}"
                        Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                        AutomationProperties.Name="Cancel running driver action"/>
            </StackPanel>

            <!-- Done state -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OutcomeTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OutcomeDetail}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RestartStateLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                           FontWeight="SemiBold"/>
                <ListBox ItemsSource="{Binding ItemResults}" MaxHeight="180" Margin="0,6,0,0"
                         AutomationProperties.Name="Per-device results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusText, StringFormat=' — {0}'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding RollbackHintLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="View in History" Command="{Binding ViewHistoryCommand}" Padding="12,6"
                            Margin="0,0,8,0"
                            Visibility="{Binding HasViewHistory, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="View results in History"/>
                    <Button Content="Close" Command="{Binding CloseCommand}" Padding="12,6"
                            IsDefault="True"
                            AutomationProperties.Name="Close results"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
