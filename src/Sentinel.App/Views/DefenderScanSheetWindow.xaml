<Window x:Class="Sentinel.App.Views.DefenderScanSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Defender scan" Height="520" Width="620"
        MinHeight="420" MinWidth="520"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- T50: the last human gate for Defender scans. Confirm
                 starts exactly the scan described below. -->
            <TextBlock Text="{Binding ActionTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding KindLine}" FontSize="14" Margin="0,4,0,0"/>

            <!-- Preview state -->
            <StackPanel Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Defender will run:" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock Text="{Binding CommandLine}" FontFamily="Consolas" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DetailLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding RemediationLine}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ElevationLine}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ProgressLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <CheckBox Content="I understand this PC will restart into the offline environment."
                          IsChecked="{Binding RestartAcknowledged, Mode=TwoWay}"
                          Margin="0,10,0,0"
                          Visibility="{Binding NeedsRestartAck, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="Acknowledge restart"/>
                <TextBlock Text="{Binding RefusedReason}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="IndianRed"
                           Visibility="{Binding IsRefusedPreview, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Confirm — start this scan"
                            Command="{Binding ConfirmCommand}" Padding="12,6" Margin="0,0,8,0"
                            IsDefault="True"
                            AutomationProperties.Name="Confirm Defender scan"/>
                    <Button Content="Cancel" Command="{Binding CloseCommand}" Padding="12,6"
                            IsCancel="True"
                            AutomationProperties.Name="Cancel Defender scan"/>
                </StackPanel>
            </StackPanel>

            <!-- Running state -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Requesting…" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProgressText}" Margin="0,4,0,0"/>
                <Button Content="Stop waiting (the Defender scan continues)"
                        Command="{Binding CancelRunCommand}"
                        Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                        AutomationProperties.Name="Stop waiting for scan"/>
            </StackPanel>

            <!-- Done state -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OutcomeTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OutcomeDetail}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="View in History" Command="{Binding ViewHistoryCommand}" Padding="12,6"
                            Margin="0,0,8,0"
                            Visibility="{Binding HasViewHistory, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="View results in History"/>
                    <Button Content="Close" Command="{Binding CloseCommand}" Padding="12,6"
                            IsDefault="True"
                            AutomationProperties.Name="Close results"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
