<UserControl x:Class="Sentinel.App.Views.CrashesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Page header (board 06). -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Crashes &amp; stability" Style="{StaticResource PageTitle}"/>
                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding MachineName, Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Summary, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Coverage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                <!-- U21: deep-link scope from Overview. -->
                <TextBlock Text="{Binding DeepLinkNote}" Foreground="{DynamicResource AccentBrush}"
                           FontSize="12" FontStyle="Italic"
                           AutomationProperties.Name="Deep link scope">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDeepLinkNote}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                          Width="140" Margin="0,0,8,0" AutomationProperties.Name="Date range"/>
                <Button Click="Refresh_Click" Padding="11,7" AutomationProperties.Name="Refresh crashes">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}"
                              Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- A09: refresh fault line (collapsed while fresh). -->
        <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.Error}"/>
        <TextBlock Style="{StaticResource RefreshLoadingLine}" Text="{Binding RefreshState.LoadingText}"/>

        <!-- Event timeline (board 06): dots + legend counts. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="System events" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" FontSize="12">
                            <Run Text="Crash "/><Run Text="{Binding CrashCount, Mode=OneWay}"/>
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" FontSize="12">
                            <Run Text="Hang "/><Run Text="{Binding HangCount, Mode=OneWay}"/>
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" FontSize="12">
                            <Run Text="Disk warning "/><Run Text="{Binding DiskCount, Mode=OneWay}"/>
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" FontSize="12">
                            <Run Text="Update "/><Run Text="{Binding UpdateCount, Mode=OneWay}"/>
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12">
                            <Run Text="Hardware error "/><Run Text="{Binding HardwareCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Canvas x:Name="TimelineStrip" Height="44" Background="Transparent"
                        AutomationProperties.Name="Event timeline"/>
                <TextBlock Text="Each dot is one event in the selected range, oldest left." FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Reliability + minidump history. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding ReliabilityLine}" TextWrapping="Wrap"
                           AutomationProperties.Name="Reliability history"/>
                <TextBlock Text="{Binding MinidumpLine}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.Name="Crash dump history"/>
                <ItemsControl ItemsSource="{Binding Dumps}" Margin="0,4,0,0"
                              AutomationProperties.Name="Crash dumps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,1,0,1"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas, monospace"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Status, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding BugCheckName, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Module, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Events table (board 06). -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Events" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding RelatedCaption}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedEventType, Mode=TwoWay}"
                                      Width="160" AutomationProperties.Name="Event type filter"/>
                            <Button Content="Clear" Command="{Binding ClearRelatedCommand}" Margin="8,0,0,0" Padding="9,4"
                                    Visibility="{Binding HasRelatedFilter, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Clear event filter"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="EventsGrid" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              Height="330" AutomationProperties.Name="Crash events" IsReadOnly="True"
                              AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date &amp; time" Binding="{Binding When}" Width="140"/>
                            <DataGridTemplateColumn Header="Type" Width="150" SortMemberPath="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Crash">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Hang">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Update">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Hardware error">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Path Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent" Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconInfo}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Crash">
                                                                    <Setter Property="Data" Value="{StaticResource IconX}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Hang">
                                                                    <Setter Property="Data" Value="{StaticResource IconAlertTriangle}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Hardware error">
                                                                    <Setter Property="Data" Value="{StaticResource IconAlertTriangle}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Update">
                                                                    <Setter Property="Data" Value="{StaticResource IconRefresh}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <TextBlock Text="{Binding Type}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                            <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Event detail (board 06 right column). -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Select a row to see the evidence."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"
                                        Background="{DynamicResource InfoBrush}">
                                    <Path Data="{StaticResource IconInfo}" Width="17" Height="17"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.9"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCard.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                <Border Grid.Column="2" Style="{StaticResource WarningPill}" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding OverallConfidence}" Style="{StaticResource PillText}"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Margin="44,4,0,12" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                                <Run Text="{Binding SelectedRow.Type, Mode=OneWay}"/>
                                <Run Text=" · Event "/>
                                <Run Text="{Binding SelectedRow.EventId, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SelectedRow.When, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="Observed evidence" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Provider" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedAnchor.Provider}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Channel" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAnchor.Log}" FontSize="12"/>
                                <TextBlock Grid.Row="2" Text="Event ID (Record ID)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAnchor.RecordId}" FontSize="12"/>
                                <TextBlock Grid.Row="3" Text="Level" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAnchor.Level}" FontSize="12"/>
                                <TextBlock Grid.Row="4" Text="Device" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="Possible explanations" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedCard.Findings}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Cause}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="Confidence: "/><Run Text="{Binding Confidence, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Citations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="What to check next" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedCard.Prevention}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource BulletPrefix}}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Show this event only" Command="{Binding ShowRelatedCommand}"
                                        Padding="9,5" Margin="0,0,6,6" AutomationProperties.Name="Show this event only"/>
                                <Button Content="Review disk events" Command="{Binding ReviewDiskEventsCommand}"
                                        Padding="9,5" Margin="0,0,6,6" AutomationProperties.Name="Review disk events"/>
                                <Button Content="Compare device state" Command="{Binding OpenDriversCommand}"
                                        Padding="9,5" Margin="0,0,6,6" AutomationProperties.Name="Compare device state"/>
                                <Button Content="Open Event Viewer" Command="{Binding OpenEventViewerCommand}"
                                        Padding="9,5" Margin="0,0,6,6" AutomationProperties.Name="Open Event Viewer"/>
                                <Button Content="Open storage view" Command="{Binding OpenStorageCommand}"
                                        Padding="9,5" Margin="0,0,6,6" AutomationProperties.Name="Open storage view"/>
                            </WrapPanel>
                            <Expander Margin="0,0,0,12" AutomationProperties.Name="Raw event details">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFileText}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="Raw event details" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedAnchor.Message}" TextWrapping="Wrap" FontSize="12"/>
                                    <ItemsControl ItemsSource="{Binding SelectedAnchor.Properties}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding AskAboutThisCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,7"
                                        AutomationProperties.Name="Ask about this event">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}"
                                              Width="14" Height="14" Stroke="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ask about this event" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Copy details" Command="{Binding CopyDetailsCommand}" Padding="12,7"
                                        AutomationProperties.Name="Copy crash details"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Weekly stacked counts (board 06). -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Recorded crash events / week" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <Canvas x:Name="WeeksCanvas" Height="120" Background="Transparent"
                        AutomationProperties.Name="Weekly event counts"/>
                <TextBlock Text="Stacked event counts by week (last 30 days)." FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
