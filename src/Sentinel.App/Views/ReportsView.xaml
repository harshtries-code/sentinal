<UserControl x:Class="Sentinel.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Page header (board 08). -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="A clear handoff for your technician"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Click="Generate_Click" Padding="16,9"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Generate report">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFileText}" Style="{StaticResource IconPath}"
                          Width="15" Height="15" Stroke="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Generate report" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- A09: refresh fault line (collapsed while fresh). -->
        <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.LoadingText}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Report library (board 08). -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Report library" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFileText}" Style="{StaticResource IconPath}"
                                      Width="16" Height="16" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Current draft" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DraftTitle}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding DraftState}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Save draft" Command="{Binding SaveDraftCommand}"
                            Margin="0,0,0,12" Padding="11,6"
                            AutomationProperties.Name="Save draft"/>
                    <TextBlock Text="Saved reports" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ReportHistory}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding SavedReports}"
                             SelectedItem="{Binding SelectedSaved, Mode=TwoWay}"
                             MaxHeight="180" Margin="0,0,0,6"
                             AutomationProperties.Name="Saved reports">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontSize="12"/>
                                    <TextBlock Text="{Binding SavedLocal}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Reopen selected" Command="{Binding ReopenCommand}"
                            Margin="0,0,0,6" Padding="11,6"
                            AutomationProperties.Name="Reopen selected report"/>
                    <TextBlock Text="{Binding LibraryNote}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Document preview (board 08). -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Document preview" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="−" Click="ZoomOut_Click" Width="28" Padding="0" MinHeight="0" Margin="0,0,4,0"
                                    AutomationProperties.Name="Zoom out"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" Width="48" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <Button Content="+" Click="ZoomIn_Click" Width="28" Padding="0" MinHeight="0" Margin="4,0,8,0"
                                    AutomationProperties.Name="Zoom in"/>
                            <Button Command="{Binding CopyPreviewCommand}" Padding="10,5"
                                    AutomationProperties.Name="Copy summary">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFile}" Style="{StaticResource IconPath}"
                                          Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy summary" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PreviewDoc" Margin="4">
                            <TextBlock Text="Press Generate to build the report." FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasDraft, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <StackPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Sentinel · Technician report" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,12" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="{Binding Draft.GeneratedLocal, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Draft.Machine, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Draft.OsName, Mode=OneWay}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconMonitor}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Device summary" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="23,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Scope" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Draft.ScanScope}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="Coverage" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Draft.CoverageLine}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="Storage" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Draft.Storage}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Text="Devices" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Draft.Drivers}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Text="Protection" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Draft.Protection}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="5" Text="Stability" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Draft.StabilityDetail}" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconHardDrive}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Storage" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Draft.DriveLines}" Margin="23,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource BulletPrefix}}" FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconCpu}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Devices and drivers" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="23,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="No device issues found."/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Draft.DriverIssueNames.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Draft.DriverIssueNames}" Margin="23,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource BulletPrefix}}" FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconActivity}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stability" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Draft.StabilityDetail}" FontSize="12" Margin="23,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Protection" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Draft.ProtectionDetail}" FontSize="12" Margin="23,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconHistory}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Recent actions" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Draft.ActionsCoverage}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="23,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding Draft.ActionLines}" Margin="23,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource BulletPrefix}}" FontSize="12" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconFileText}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open questions" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="23,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="None found in this inspection."/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Draft.OpenIssues.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Draft.OpenIssues}" Margin="23,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource BulletPrefix}}" FontSize="12" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconCamera}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Photos" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Draft.PhotoNote}" FontSize="12" Margin="23,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Path Data="{StaticResource IconList}" Style="{StaticResource IconPath}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Section coverage" FontWeight="SemiBold" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Draft.Sections}" Margin="23,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2">
                                                <Run Text="{Binding Section, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Coverage, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Export options (board 08). -->
            <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Export options" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <RadioButton Content="Readable HTML" GroupName="ReportFormat" IsChecked="True"
                                         Tag="HTML" Checked="Format_Checked"
                                         AutomationProperties.Name="HTML format"/>
                            <TextBlock Text="Clean, formatted report for sharing with a technician" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <RadioButton Content="JSON" GroupName="ReportFormat"
                                         Tag="JSON" Checked="Format_Checked"
                                         AutomationProperties.Name="JSON format"/>
                            <TextBlock Text="Technical data for advanced users and support teams" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Button Click="Export_Click" Padding="14,9" Margin="0,0,0,14"
                            AutomationProperties.Name="Export report">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDraft}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconFileText}" Style="{StaticResource IconPath}"
                                  Width="14" Height="14" Stroke="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Export selected format" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Included" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,2"/>
                    <TextBlock Text="These items will be included in the report." FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Margin="0,0,0,12" x:Name="IncludedList">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Device summary" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Storage findings" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Devices and drivers" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Stability (crashes and warnings)" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Protection (threats and status)" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Recent actions" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Photos" FontSize="12.5" Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Open questions in this report" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,2"/>
                    <TextBlock Text="Uncheck a finding to leave it out." FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding FindingSelections}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Issue}"
                                          IsChecked="{Binding Included, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,3"
                                          AutomationProperties.Name="Include finding"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Excluded" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Path Data="{StaticResource IconMinusCircle}" Style="{StaticResource IconPath}"
                              Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,7,0"/>
                        <TextBlock Text="{Binding NotInReport}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Command="{Binding ReviewFindingsCommand}" Padding="12,8" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Review included findings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconList}" Style="{StaticResource IconPath}"
                                  Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Review included findings" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}"
                                  Width="14" Height="14" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
