<UserControl x:Class="Sentinel.App.Views.ThreatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Page header (board 05): title left, Defender actions right. -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Threats" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding MachineLine}" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Refresh_Click" Padding="11,7" Margin="0,0,8,0"
                        AutomationProperties.Name="Refresh evidence">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}"
                              Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh evidence" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="QuickScan_Click" Padding="14,7" Margin="0,0,8,0"
                        AutomationProperties.Name="Defender quick scan"
                        ToolTip="Opens the confirmation step, then asks Defender to quick-scan.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPath}"
                              Width="15" Height="15" Stroke="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Quick scan" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="FullScan_Click" Padding="12,7" Margin="0,0,8,0"
                        AutomationProperties.Name="Defender full scan"
                        ToolTip="Opens the confirmation step, then asks Defender to full-scan.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconList}" Style="{StaticResource IconPath}"
                              Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Full scan" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="FolderScan_Click" Padding="12,7" Margin="0,0,8,0"
                        AutomationProperties.Name="Defender folder scan"
                        ToolTip="Opens the confirmation step, then asks Defender to scan a folder.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}"
                              Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Scan folder" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Offline scan" Click="OfflineScan_Click" Padding="12,7"
                        AutomationProperties.Name="Defender offline scan"
                        ToolTip="Opens the confirmation step (with restart acknowledgement) for an offline scan."/>
            </StackPanel>
        </Grid>
        <!-- A09: refresh fault line (collapsed while fresh). -->
        <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.Error}"/>
            <TextBlock Style="{StaticResource RefreshLoadingLine}" Text="{Binding RefreshState.LoadingText}"/>
        <TextBlock Text="{Binding ScanNote}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ScanNote}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Defender banner (board 05): teal when protected, amber otherwise. -->
        <Border BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RtpState}" Value="On">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconShield}" Width="34" Height="34"
                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RtpState}" Value="On">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Banner}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BannerDetail}" FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="2" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Virus &amp; threat definitions" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DefinitionsLine}" FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Last scan" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DefenderScanLine}" FontWeight="SemiBold" FontSize="13.5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Policy note (board 05 info line). -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
            <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}"
                  Width="16" Height="16" Stroke="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,8,0"/>
            <TextBlock Text="Defender may quarantine detections under its protection policy. Sentinel AI does not remove files."
                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl x:Name="SectionsTab" AutomationProperties.Name="Threat sections">
            <TabItem Header="Detections" AutomationProperties.Name="Detections tab">
                <StackPanel>
                    <!-- Detection timeline filters. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding SeverityOptions}"
                                  SelectedItem="{Binding DetectionSeverityFilter, Mode=TwoWay}"
                                  Width="140" VerticalAlignment="Center"
                                  AutomationProperties.Name="Detection severity filter"/>
                        <TextBox Text="{Binding DetectionSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="240" Margin="8,0,0,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Detection search"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding FilteredDetections}"
                                  SelectedItem="{Binding SelectedDetection, Mode=TwoWay}"
                                  Height="300" AutomationProperties.Name="Detections">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Threat" Width="*" SortMemberPath="Threat">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Threat}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="6" Padding="6,1"
                                                        HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTest}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Test fixture" FontSize="11" Foreground="{DynamicResource InfoBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Severity" Width="100" SortMemberPath="Severity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Severe">
                                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                    <Setter Property="Fill" Value="{DynamicResource InfoBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Severity}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Severe">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Resource" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="Detected" Binding="{Binding Detected}" Width="130"/>
                                <DataGridTextColumn Header="Defender action" Binding="{Binding Action}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Detection evidence drawer (board 05). -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                                AutomationProperties.Name="Detection evidence">
                            <Grid>
                                <TextBlock Text="Select a detection to inspect its evidence." FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetection}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel DataContext="{Binding SelectedDetection}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Detection evidence" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Threat name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Threat}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTest}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Test fixture" FontSize="11" Foreground="{DynamicResource InfoBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="Severity" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Width="92"/>
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Severe">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="High">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                            <Setter Property="Fill" Value="{DynamicResource InfoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Severity}" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Resource" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Path}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Copy" Click="CopyResource_Click" Padding="8,1" Margin="6,0,0,0"
                                                AutomationProperties.Name="Copy resource path"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SHA-256" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataContext.DetectionEvidence.HashDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Copy" Click="CopyHash_Click" Padding="8,1" Margin="6,0,0,0"
                                                AutomationProperties.Name="Copy detection hash"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Signature" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DataContext.DetectionEvidence.SignedLine, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Reported by" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="Microsoft Defender" FontSize="12"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Detected" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detected}" FontSize="12"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Current file availability" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DataContext.DetectionEvidence.AvailabilityLine, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="Recommendation" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Review evidence" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <!-- Check a file (board 05 dashed drop zone). -->
                        <Border Style="{StaticResource Card}" Margin="0,0,6,0"
                                AllowDrop="True" Drop="CheckFile_Drop" DragOver="CheckFile_DragOver">
                            <StackPanel>
                                <TextBlock Text="Check a file" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Inspect hash, signature and available evidence."
                                           Style="{StaticResource SectionCaption}" Margin="0,2,0,10"/>
                                <Grid Height="118">
                                    <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderBrush}"
                                               StrokeThickness="1" StrokeDashArray="4 3"
                                               Fill="{DynamicResource SurfaceRaisedBrush}" Opacity="0.55"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconFile}" Style="{StaticResource IconPath}"
                                              Width="22" Height="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drag and drop a file here" FontSize="12.5" Margin="0,7,0,8"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <Button Content="Choose file" Click="ChooseFile_Click" Padding="14,6"
                                                Style="{StaticResource AccentOutlineButton}" HorizontalAlignment="Center"
                                                AutomationProperties.Name="Choose file to check"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding FileCheck.Title}" FontWeight="SemiBold" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileCheck}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileCheck}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding FileCheck.HashDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileCheck.SignedLine, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileCheck.SizeLine, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding FileCheck.Explanation}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileCheck}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FileCheck.SecondOpinion}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileCheck}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="No complete sample upload. We perform local analysis and query available evidence."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Persistence locations summary (board 05). -->
                        <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Persistence locations" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Common locations that can keep malware on your device."
                                           Style="{StaticResource SectionCaption}" Margin="0,2,0,8"/>
                                <TextBlock Text="{Binding RunKeyLine}" FontSize="12.5" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding StartupFolderLine}" FontSize="12.5" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ServiceLine}" FontSize="12.5" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TaskLine}" FontSize="12.5" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ExtensionLine}" FontSize="12.5" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding WmiLine}" FontSize="12.5" Margin="0,0,0,8"/>
                                <Button Content="View all ›" Click="ViewPersistence_Click" Padding="0" HorizontalAlignment="Left"
                                        Style="{StaticResource LinkButton}"
                                        AutomationProperties.Name="View all persistence"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Processes" AutomationProperties.Name="Processes tab">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Processes}" Height="300"
                              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                              AutomationProperties.Name="Threat processes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="80"/>
                            <DataGridTextColumn Header="Started by" Binding="{Binding Parent}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding ProcessDetailLine}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               AutomationProperties.Name="Process detail">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </TabItem>
            <TabItem Header="Watching" AutomationProperties.Name="Watching tab">
                <StackPanel>
                    <TextBlock Text="{Binding WatchLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding WatchFeed}" Height="300" AutomationProperties.Name="Watch cards">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seen" Binding="{Binding Time}" Width="70"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Check" Binding="{Binding Verdict}" Width="130"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                            <DataGridTextColumn Header="From" Binding="{Binding Source}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Nothing new since the app opened — new processes and executables will appear here." FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WatchFeed.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </TabItem>
            <TabItem Header="Persistence" AutomationProperties.Name="Persistence tab">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Persistence}" Height="300"
                              SelectedItem="{Binding SelectedPersistence, Mode=TwoWay}"
                              AutomationProperties.Name="Persistence entries">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                            <DataGridTextColumn Header="Check first" Binding="{Binding Suspicion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding PersistenceDetailLine}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               AutomationProperties.Name="Persistence detail">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </TabItem>
            <TabItem Header="Quarantine" AutomationProperties.Name="Quarantine tab">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Quarantine}" Height="260"
                              SelectedItem="{Binding SelectedQuarantine, Mode=TwoWay}"
                              AutomationProperties.Name="Quarantined items">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Threat" Binding="{Binding Threat}" Width="*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Resource}" Width="*"/>
                            <DataGridTextColumn Header="Detected" Binding="{Binding Detected}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding QuarantineNote}" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedQuarantine.Explanation}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               AutomationProperties.Name="Quarantine explanation">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Restore…" Click="Restore_Click" Padding="12,6" Margin="0,0,8,0"
                                AutomationProperties.Name="Restore quarantined item"/>
                        <Button Content="Keep quarantined" Click="Keep_Click" Padding="12,6" Margin="0,0,8,0"
                                AutomationProperties.Name="Keep quarantined"/>
                        <Button Content="Report to Microsoft…" Click="Report_Click" Padding="12,6"
                                AutomationProperties.Name="Report to Microsoft"/>
                    </StackPanel>
                    <TextBlock Text="{Binding QuarantineActionNote}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.Name="Quarantine action note"/>
                    <TextBlock Text="Defender owns quarantine — Sentinel restores only what is currently listed, with your confirmation." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Text="{Binding Coverage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
