<Window x:Class="Sentinel.App.Views.ConfirmSheetWindow" Style="{StaticResource SentinelWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm action" Height="600" Width="680"
        MinHeight="480" MinWidth="560"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- E33: the last human gate. Every line below names what
                 will happen; Confirm approves exactly the listed files. -->
            <TextBlock Text="{Binding ActionTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CountLine}" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding AsOfLine}" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding ScopeLine}" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- Preview state -->
            <StackPanel Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="These files will be moved to the Vault:"
                           FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ListBox ItemsSource="{Binding Included}" MaxHeight="180"
                         AutomationProperties.Name="Files to vault">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SizeText, StringFormat=' · {0}'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Tier, StringFormat=' · {0}'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding ExcludedLine}" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ListBox ItemsSource="{Binding Excluded}" MaxHeight="110"
                         Visibility="{Binding HasExcluded, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="Excluded selections">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding BackupLine}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PermissionLine}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ElevationLine}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LimitationsLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding RefusedReason}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="IndianRed"
                           Visibility="{Binding IsRefusedPreview, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Confirm — move these files to the Vault"
                            Command="{Binding ConfirmCommand}" Padding="12,6" Margin="0,0,8,0"
                            IsDefault="True"
                            AutomationProperties.Name="Confirm vault action"/>
                    <Button Content="Cancel" Command="{Binding CloseCommand}" Padding="12,6"
                            IsCancel="True"
                            AutomationProperties.Name="Cancel vault action"/>
                </StackPanel>
            </StackPanel>

            <!-- Running state -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Working — every file is re-checked before it moves:"
                           FontWeight="SemiBold"/>
                <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}" Height="18" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding ProgressText}" Margin="0,4,0,0"/>
                <Button Content="Cancel" Command="{Binding CancelRunCommand}"
                        Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                        AutomationProperties.Name="Cancel running action"/>
            </StackPanel>

            <!-- Done state -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OutcomeTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OutcomeDetail}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding ItemResults}" MaxHeight="180" Margin="0,6,0,0"
                         AutomationProperties.Name="Per-file results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusText, StringFormat=' — {0}'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Undo — restore these files from the Vault"
                        Command="{Binding UndoCommand}" Padding="12,6" Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding UndoAvailable, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Undo vault action"/>
                <TextBlock Text="{Binding UndoLine}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="View in History" Command="{Binding ViewHistoryCommand}" Padding="12,6"
                            Margin="0,0,8,0"
                            Visibility="{Binding HasViewHistory, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="View results in History"/>
                    <Button Content="Close" Command="{Binding CloseCommand}" Padding="12,6"
                            IsDefault="True"
                            AutomationProperties.Name="Close results"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
