<UserControl x:Class="Sentinel.App.Views.AskPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Background="{DynamicResource SurfaceBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                        Command="{Binding CloseCommand}" AutomationProperties.Name="Close panel"/>
                <TextBlock Text="Ask Sentinel" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Answers come only from your scans, crash log, and knowledge pack."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.ChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Ask" Width="56" Margin="6,0,0,0"
                        Command="{Binding SubmitCommand}"/>
                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500" AutomationProperties.Name="Your question">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <TextBlock Text="{Binding StatusLabel}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Answer.Fact}" FontSize="13" TextWrapping="Wrap"
                       LineHeight="20" Margin="0,0,0,6"/>
            <!-- U27: the "why" line. Collapsed unless the answer
                 carries detail, so non-crash answers show no gap. -->
            <TextBlock Text="{Binding Answer.Detail}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,0,0,6"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding CloudStatus}" FontSize="12"
                       Foreground="{DynamicResource AccentBrush}" FontStyle="Italic"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Answer.Evidence}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="6,3" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                           FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{Binding ActionLabel}" Click="Action_Click"
                    HorizontalAlignment="Left" Padding="10,4">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
