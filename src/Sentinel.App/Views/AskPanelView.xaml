<UserControl x:Class="Sentinel.App.Views.AskPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="424" Background="{DynamicResource SurfaceBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCommand}"
                            AutomationProperties.Name="Close panel" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Ask Sentinel" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="Ask a question about this PC." Style="{StaticResource SectionCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding CloudStatus}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,8" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAnswer}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Suggested questions" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.ChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Background="{DynamicResource AccentSoftBrush}" Padding="12,10" CornerRadius="10"
                            Margin="24,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubmittedQuestion}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SubmittedQuestion}" TextWrapping="Wrap" FontSize="14"/>
                    </Border>

                    <TextBlock Text="Checking the available evidence…" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentInkBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Answer.Fact}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" LineHeight="22"/>
                            <TextBlock Text="{Binding Answer.Detail}" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Answer.Evidence}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="7"
                                                Padding="9,7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentInkBrush}"/>
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding ActionLabel}" Click="Action_Click" Margin="0,10,0,0"
                                    Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                    Visibility="{Binding ActionVisible, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ask" Width="60" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"/>
                    <TextBox x:Name="QuestionBox" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500" AutomationProperties.Name="Your question" ToolTip="Ask about this PC">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="Answers use available scan evidence and Windows records."
                           Style="{StaticResource SectionCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
