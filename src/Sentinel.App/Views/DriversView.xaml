<UserControl x:Class="Sentinel.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Page header (board 04). -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Drivers &amp; devices" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding MachineLine}" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- P28: diagnostic boundaries, always visible. -->
                <TextBlock Text="{Binding Boundaries}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.Name="Diagnostic boundaries"/>
            </StackPanel>
            <Button Grid.Column="1" Click="Refresh_Click" Padding="12,7"
                    Margin="0,0,10,0" VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh inventory">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}"
                          Width="15" Height="15" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh inventory" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" Text="{Binding LiveLine}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>

        <!-- A09: refresh fault line (collapsed while fresh). -->
        <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.Error}"/>
        <TextBlock Style="{StaticResource RefreshLoadingLine}" Text="{Binding RefreshState.LoadingText}"/>

        <!-- Attention banner (board 04: amber) or calm state. -->
        <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10"
                Background="{DynamicResource WarningSoftBrush}" Padding="16,12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblems}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconAlertTriangle}" Width="30" Height="30"
                      Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.7"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Review the devices below for driver issues." FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DriverCountLine}" VerticalAlignment="Center" TextAlignment="Right"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
        <Border Padding="16,12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblems}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Summary}" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DriverCountLine}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Devices table + topology tabs. No driver-packages
                 tab: no collector backs it (retained plan). -->
            <TabControl Grid.Column="0" AutomationProperties.Name="Driver sections">
                <TabItem AutomationProperties.Name="Devices tab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMonitor}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Devices" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="{Binding ChipAll}" Click="ChipAll_Click" Padding="12,5" Margin="0,0,6,0"
                                    AutomationProperties.Name="Show all devices">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemsOnly}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding ChipProblems}" Click="ChipProblems_Click" Padding="12,5" Margin="0,0,6,0"
                                    AutomationProperties.Name="Show problem devices">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemsOnly}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <CheckBox Content="Show disconnected devices" IsChecked="{Binding ShowDisconnected, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                      AutomationProperties.Name="Show disconnected devices"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  Height="330" AutomationProperties.Name="Devices">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Device" Width="*" SortMemberPath="Device">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconMonitor}" Style="{StaticResource IconPath}"
                                                      Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Device}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                                <DataGridTemplateColumn Header="Status" Width="180" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                            <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                                                    <Setter Property="Data" Value="{StaticResource IconAlertTriangle}"/>
                                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Phantom">
                                                                    <Setter Property="Data" Value="{StaticResource IconMinusCircle}"/>
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Phantom">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem AutomationProperties.Name="Disk topology tab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHardDrive}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Disk topology" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="Physical disks and volumes. Select a disk or volume to view details." Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ChkdskLine}" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   AutomationProperties.Name="Filesystem check history"/>
                        <ItemsControl ItemsSource="{Binding Topology}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconHardDrive}" Style="{StaticResource IconPath}"
                                                      Width="20" Height="20" VerticalAlignment="Center"/>
                                                <StackPanel Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Partitions}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                Padding="10,7" Margin="0,0,6,6" MinWidth="150">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding StatusLine}" FontSize="12" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Disk topology could not be inspected — see Coverage." FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Topology.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Device drawer (board 04): record fields + note + copy.
                 No report or vendor actions: no backends back them. -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    AutomationProperties.Name="Device detail">
                <Grid>
                    <TextBlock Text="Select a device to inspect it." FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel DataContext="{Binding SelectedDevice}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCpu}" Style="{StaticResource IconPath}"
                                  Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,8,0"/>
                            <TextBlock Text="{Binding Device}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border CornerRadius="8" Padding="10,8" Margin="0,10,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                            <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                                    <Setter Property="Data" Value="{StaticResource IconAlertTriangle}"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Phantom">
                                                    <Setter Property="Data" Value="{StaticResource IconMinusCircle}"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Problem">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Phantom">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Device instance ID" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.InstanceId}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Copy" Click="CopyInstance_Click" Padding="8,1" Margin="6,0,0,0"
                                    AutomationProperties.Name="Copy instance ID"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Driver version" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Version}" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Publisher}" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Evidence source" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.Source}" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Observation time" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.Observed}" FontSize="12"/>
                        </Grid>
                        <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Padding="10,8" Margin="0,8,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}"
                                      Width="16" Height="16" Stroke="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                <TextBlock Text="A problem code identifies the symptom, not its cause. Further investigation may be needed to determine the root cause." FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Copy details" Click="CopyDetails_Click" Padding="12,6"
                                Style="{StaticResource AccentOutlineButton}"
                                AutomationProperties.Name="Copy device details"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Driver update/rollback for the selected device. Checks
             are read-only; changes confirm in the driver sheet.
             Hidden when actions aren't wired (honestly read-only). -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding ActionsAvailable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" Width="17" Height="17" VerticalAlignment="Center"/>
                    <TextBlock Text="Driver updates" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Check for updates" Click="CheckUpdates_Click" Padding="10,4"
                            Margin="0,0,8,0" IsEnabled="{Binding CanCheckUpdates}"
                            AutomationProperties.Name="Check for driver updates"/>
                    <Button Content="Cancel check" Click="CancelCheck_Click" Padding="10,4"
                            Margin="0,0,8,0" IsEnabled="{Binding IsChecking}"
                            AutomationProperties.Name="Cancel driver check"/>
                    <Button Content="Review &amp; confirm…" Click="ReviewUpdate_Click" Padding="10,4"
                            IsEnabled="{Binding CanOpenUpdateSheet}"
                            AutomationProperties.Name="Review driver update"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdateStateLine}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ListBox ItemsSource="{Binding UpdateCandidates}" MaxHeight="120" Margin="0,6,0,0"
                         AutomationProperties.Name="Update candidates">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding InstalledVersion}"/><Run Text=" → "/><Run Text="{Binding Candidate.Version}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding WhyEligible}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox ItemsSource="{Binding UpdateUnsupported}" MaxHeight="120" Margin="0,6,0,0"
                         AutomationProperties.Name="Devices without updates">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding LinkOuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding VendorName}" Tag="{Binding Url}"
                                                    Click="LinkOut_Click" Padding="8,1" Margin="0,2,6,0"
                                                    AutomationProperties.Name="Open vendor page"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding OemSetLine}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Path Data="{StaticResource IconUndo}" Style="{StaticResource IconPath}" Width="17" Height="17" VerticalAlignment="Center"/>
                    <TextBlock Text="Rollback" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Check for rollback target" Click="CheckRollback_Click" Padding="10,4"
                            Margin="0,0,8,0" IsEnabled="{Binding CanCheckRollback}"
                            AutomationProperties.Name="Check for rollback target"/>
                    <Button Content="Review &amp; confirm…" Click="ReviewRollback_Click" Padding="10,4"
                            IsEnabled="{Binding CanOpenRollbackSheet}"
                            AutomationProperties.Name="Review driver rollback"/>
                </StackPanel>
                <TextBlock Text="{Binding RollbackStateLine}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ListBox ItemsSource="{Binding RollbackCandidates}" MaxHeight="100" Margin="0,6,0,0"
                         AutomationProperties.Name="Rollback candidates">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding BadVersion}"/><Run Text=" → "/><Run Text="{Binding PreviousVersion}"/>
                                    <Run Text=" ("/><Run Text="{Binding TargetInf}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox ItemsSource="{Binding RollbackUnsupported}" MaxHeight="100" Margin="0,6,0,0"
                         AutomationProperties.Name="Devices without rollback">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
