<UserControl x:Class="Sentinel.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Performance &amp; power" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding MachineLine}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Coverage}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="360" TextAlignment="Right"/>
        </Grid>

        <!-- A09: refresh fault line (collapsed while fresh). -->
        <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.Error}"/>
            <TextBlock Style="{StaticResource RefreshLoadingLine}" Text="{Binding RefreshState.LoadingText}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Tabs consolidate the board's sections (all content
                 kept, every control real). Power holds battery +
                 disks; the right rail is always Sentinel itself. -->
            <TabControl Grid.Column="0" AutomationProperties.Name="Performance sections">
                <TabItem Header="Processes" AutomationProperties.Name="Processes tab">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding Processes.Count, Mode=OneWay}"/><Run Text=" items · by memory"/>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Processes}" Height="330"
                                  AutomationProperties.Name="Processes by memory">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="100"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="80"/>
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Company}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Startup" AutomationProperties.Name="Startup tab">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding StartupItems.Count, Mode=OneWay}"/><Run Text=" items · enabling or disabling is suspended pending a safety review — this list is read-only"/>
                        </TextBlock>
                        <TextBlock Text="{Binding BootLine}" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <DataGrid ItemsSource="{Binding StartupItems}" Height="330"
                                  AutomationProperties.Name="Startup programs">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="110"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                                <DataGridTextColumn Header="Observed impact" Binding="{Binding Impact}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Power" AutomationProperties.Name="Power tab">
                    <StackPanel>
                        <TextBlock Text="Battery" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding BatteryEmpty}" FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BatteryCard}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel DataContext="{Binding BatteryCard}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Charge}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Free-space history" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="One sample per volume per visit; 90-day retention."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DriveTrends}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Line}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Crash history" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CrashTrend}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Disk health" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DiskCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                            Background="{DynamicResource SurfaceBrush}" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Health}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Attention}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="2" Content="›" Padding="8,0"
                                                    Command="{Binding DataContext.OpenDriversCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Open disk topology on Drivers"
                                                    AutomationProperties.Name="Open disk topology"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Sentinel's own sampled resources + range. -->
            <StackPanel Grid.Column="2">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sentinel resource use" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding Ranges}"
                                      SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                                      AutomationProperties.Name="Resource history range"/>
                        </Grid>
                        <TextBlock Text="CPU and memory used by Sentinel only." FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Canvas x:Name="GraphCanvas" Height="150" SizeChanged="GraphCanvas_SizeChanged"
                                    AutomationProperties.Name="Sentinel CPU history"/>
                            <TextBlock Text="No samples yet — the graph fills as Sentinel runs." FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GraphPoints.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CpuNow}" FontWeight="SemiBold"/>
                                <TextBlock Text="CPU" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding MemoryNow}" FontWeight="SemiBold"/>
                                <TextBlock Text="Memory" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding IoNow}" FontWeight="SemiBold"/>
                                <TextBlock Text="I/O, this session" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Last scan cost" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ScanCost}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
