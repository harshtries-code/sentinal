<UserControl x:Class="Sentinel.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Page header (board 03). -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Performance &amp; power" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding MachineLine}" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Coverage}" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="380" TextAlignment="Right"/>
        </Grid>

        <!-- A09: refresh fault line (collapsed while fresh). -->
        <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.Error}"/>
        <TextBlock Style="{StaticResource RefreshLoadingLine}" Text="{Binding RefreshState.LoadingText}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Processes (board 03). -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Processes by memory" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Apps and background processes currently running on your PC."
                                           Style="{StaticResource SectionCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Top" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding Processes.Count, Mode=OneWay}"/><Run Text=" items"/>
                            </TextBlock>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Processes}" Height="300" Margin="0,10,0,0"
                                  AutomationProperties.Name="Processes by memory">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="100"/>
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Company}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Startup (board 03 + board 23 notes). -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Startup programs" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Apps that start automatically when you sign in to Windows."
                                           Style="{StaticResource SectionCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Top" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding StartupItems.Count, Mode=OneWay}"/><Run Text=" items"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Enabling or disabling is suspended pending a safety review — this list is read-only. "/>
                            <Run Text="{Binding BootLine, Mode=OneWay}"/>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding StartupItems}" Height="300" Margin="0,8,0,0"
                                  AutomationProperties.Name="Startup programs">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="110"/>
                                <DataGridTemplateColumn Header="State" Width="100" SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                            <Setter Property="Data" Value="{StaticResource IconMinusCircle}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                                    <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                                                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding State}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Observed impact" Binding="{Binding Impact}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right rail (board 03): Sentinel itself, battery, disks. -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sentinel resource use" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Width="148" ItemsSource="{Binding Ranges}"
                                      SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                                      AutomationProperties.Name="Resource history range"/>
                        </Grid>
                        <TextBlock Text="CPU and memory used by Sentinel only."
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,10"/>
                        <TextBlock Text="{Binding SystemMemory}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,10"
                                   AutomationProperties.Name="Live PC memory"/>
                        <TextBlock Text="CPU usage (Sentinel)" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Canvas x:Name="GraphCanvas" Height="130" SizeChanged="GraphCanvas_SizeChanged"
                                    AutomationProperties.Name="Sentinel CPU history"/>
                            <TextBlock Text="No samples yet — the graph fills as Sentinel runs." FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GraphPoints.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCpu}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="CPU (current)" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CpuNow}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGauge}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="Memory (current)" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MemoryNow}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconActivity}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="I/O (current)" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding IoNow}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Battery (board 03). -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBattery}" Style="{StaticResource IconPath}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Battery" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LiveBattery}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentInkBrush}" Margin="0,10,0,0"
                                   AutomationProperties.Name="Live battery charge"/>
                        <Grid Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding BatteryEmpty}" FontWeight="SemiBold" FontSize="13.5"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BatteryCard}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel DataContext="{Binding BatteryCard}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Disk health (board 03). -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHardDrive}" Style="{StaticResource IconPath}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Disk health" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DiskCards}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Path Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                        <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Attention}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconAlertTriangle}"/>
                                                                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="2" Text="{Binding Health}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Attention}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="3" Padding="6,2" MinHeight="0"
                                                    Command="{Binding DataContext.OpenDriversCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Open disk topology on Drivers"
                                                    AutomationProperties.Name="Open disk topology">
                                                <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Last scan cost + free-space / crash history. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Last scan cost" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ScanCost}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Free-space history" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="One sample per volume per visit; 90-day retention."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                        <ItemsControl ItemsSource="{Binding DriveTrends}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Crash history" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CrashTrend}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
