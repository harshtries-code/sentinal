<UserControl x:Class="Sentinel.App.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sentinel.App.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <!-- Page header (board 02): title + scope left, last
                 scan right. Scan actions live in the global header. -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Storage" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding ScopeLine}" FontSize="13" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LastScanLine}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>

            <!-- A09: refresh fault line (collapsed while fresh). -->
            <TextBlock Style="{StaticResource RefreshErrorLine}" Text="{Binding RefreshState.Error}"/>
            <TextBlock Style="{StaticResource RefreshLoadingLine}" Text="{Binding RefreshState.LoadingText}"/>

            <!-- Summary strip (board 02): inventoried / to review /
                 unavailable + the logical-size honesty note. -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconHardDrive}" Style="{StaticResource IconPath}"
                              Width="22" Height="22" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="inventoried" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconAlertTriangle}" Style="{StaticResource IconPath}"
                              Width="22" Height="22" Stroke="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding ReviewLine}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="to review" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconMinusCircle}" Style="{StaticResource IconPath}"
                              Width="22" Height="22" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding UnavailableLine}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="unavailable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="5" Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}"
                              Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Logical size; allocated space can differ" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- P22: sizing limits, always stated (sparse /
                 placeholders / hard links / unreadable). -->
            <TextBlock Text="{Binding LimitsLine}" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       AutomationProperties.Name="Sizing limits"/>

            <!-- Storage map with Map/Table toggle (board 02). Both
                 views show the same buckets; the ranked table keeps
                 every box keyboard- and screen-reader-reachable.
                 Clicking a box or row scopes the table below. -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Storage map" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Map" Click="MapView_Click" Padding="10,4" Margin="0" MinHeight="0" BorderThickness="0"
                                        AutomationProperties.Name="Show storage map">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMap}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Table" Click="TableView_Click" Padding="10,4" Margin="0" MinHeight="0" BorderThickness="0"
                                        AutomationProperties.Name="Show ranked table">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowTable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Visibility="{Binding ShowMap, Converter={StaticResource BoolToVisibility}}">
                        <Canvas x:Name="TreemapCanvas" Height="190" SizeChanged="TreemapCanvas_SizeChanged"
                                AutomationProperties.Name="Storage map"/>
                        <TextBlock Text="No size data — run a scan first." FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Treemap.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <DataGrid x:Name="RankedGrid" ItemsSource="{Binding RankedRows}" Height="190"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionChanged="RankedGrid_SelectionChanged"
                              Visibility="{Binding ShowTable, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="Ranked storage categories"
                              ToolTip="Same buckets as the map — largest first. Select a row to show only those folders.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                            <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="70"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Filter chips + search (board 02). -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" ItemsSource="{Binding Chips}" SelectedItem="{Binding SelectedChip, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Margin="0,0,8,0"
                         AutomationProperties.Name="Storage filters"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,5"/>
                            <Setter Property="MinHeight" Value="30"/>
                            <Setter Property="Margin" Value="0,0,2,2"/>
                            <Setter Property="FontSize" Value="12.5"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search files and folders"
                         AutomationProperties.Name="Search files and folders"/>
            </Grid>

            <!-- P22: folder scope from treemap drill-down. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding HasFolderScope, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FolderScopeLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Content="Clear" Click="ClearScope_Click" Padding="8,2"
                        AutomationProperties.Name="Clear folder scope"/>
            </StackPanel>

            <!-- Inventory table: checkbox + sortable columns.
                 Never-tier checkboxes disable in the cell. -->
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding VisibleRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Height="340" Margin="0,0,0,10" IsReadOnly="False"
                      AutomationProperties.Name="Storage inventory">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Width="36"
                                            Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                <Setter Property="Data" Value="{StaticResource IconFile}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:StorageRowKind.Orphan}">
                                                        <Setter Property="Data" Value="{StaticResource IconFolder}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:StorageRowKind.App}">
                                                        <Setter Property="Data" Value="{StaticResource IconCpu}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Classification" Width="120" SortMemberPath="Classification">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                <Setter Property="Data" Value="{StaticResource IconInfo}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Classification}" Value="Safe">
                                                        <Setter Property="Data" Value="{StaticResource IconCheckCircle}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Classification}" Value="Review">
                                                        <Setter Property="Data" Value="{StaticResource IconAlertTriangle}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Classification}" Value="Never touch">
                                                        <Setter Property="Data" Value="{StaticResource IconShield}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding Classification}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Classification}" Value="Review">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Classification}" Value="Never touch">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- P22: bounded pages over the stated inventory. -->
            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <Button Content="‹ Prev" Click="PrevPage_Click" Margin="0,0,8,0"
                        IsEnabled="{Binding HasPrevPage}"
                        AutomationProperties.Name="Previous page"/>
                <Button Content="Next ›" Click="NextPage_Click" Margin="0,0,12,0"
                        IsEnabled="{Binding HasNextPage}"
                        AutomationProperties.Name="Next page"/>
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.Name="Page position"/>
            </DockPanel>

            <!-- Selection bar (board 02): count + bytes + actions. -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CheckedLine}" VerticalAlignment="Center" FontSize="13"/>
                    <!-- Opens the Confirm Sheet for exactly the checked
                         files. No select-all exists anywhere: the sheet
                         approves the listed files only. -->
                    <Button Grid.Column="1" Content="Move to Vault…" Click="VaultChecked_Click" Padding="14,6" Margin="0,0,6,0"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Move selected files to Vault"/>
                    <Button Grid.Column="2" Content="Copy paths" Click="CopyChecked_Click" Padding="10,2" Margin="0,0,6,0"
                            Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Copy selected paths"/>
                    <Button Grid.Column="3" Content="Clear" Click="ClearChecked_Click" Padding="10,2"
                            Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Clear selection"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ActionStatusLine}" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionStatusLine}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding EmptyRowsText}" FontStyle="Italic"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleRows}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- System-managed files: honest notes + link-outs,
                 never deletion. Shown only when present. -->
            <Border Padding="16,12" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HibernationNote}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding HibernationNote}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Open power settings" Click="PowerSettings_Click" Padding="10,2"
                            AutomationProperties.Name="Open power settings"/>
                </Grid>
            </Border>
            <Border Padding="16,12" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PagefileNote}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PagefileNote}" TextWrapping="Wrap"/>
                        <TextBlock Text="Advanced system settings › Performance › Settings › Advanced › Change" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open system properties" Click="SystemProperties_Click" Padding="10,2"
                            AutomationProperties.Name="Open system properties"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Detail drawer (board 02): fields + guidance + evidence
             + copy. Hint when nothing is selected. -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top"
                AutomationProperties.Name="Storage detail">
            <Grid>
                <TextBlock Text="Select a row to inspect it." FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel DataContext="{Binding SelectedRow}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconFile}" Style="{StaticResource IconPath}"
                              Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Click="Deselect_Click" Padding="5" MinHeight="0" Margin="4,0,0,0"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                AutomationProperties.Name="Close detail">
                            <Path Data="{StaticResource IconX}" Style="{StaticResource IconPath}" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Detail.TierLine}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="28,4,0,12"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="File path" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.FullPath}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Copy" Click="CopyDetailPath_Click" Padding="8,1" Margin="6,0,0,0"
                                AutomationProperties.Name="Copy detail path"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Logical size" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Size}" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last modified" FontSize="12" Margin="0,0,0,7" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Modified}" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Hash" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.HashDisplay}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="Copy" Click="CopyDetailHash_Click" Padding="8,1" Margin="6,0,0,0"
                                AutomationProperties.Name="Copy detail hash"/>
                    </Grid>
                    <TextBlock Text="Regrowth" FontWeight="SemiBold" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.Regrowth}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail.Regrowth}" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.Regrowth}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Expander Margin="0,12,0,0" IsExpanded="True" AutomationProperties.Name="What we know">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="What we know" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="{Binding Detail.KnowLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Expander>
                    <Expander Margin="0,6,0,0" AutomationProperties.Name="What we could not verify">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="What we could not verify" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="{Binding Detail.VerifyLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Expander>
                    <Expander Margin="0,6,0,0" AutomationProperties.Name="Evidence">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFileText}" Style="{StaticResource IconPath}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Evidence" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding Detail.EvidenceLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Detail.ExtraPaths}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
