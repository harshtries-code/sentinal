<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark design tokens (02 §4, handoff §4). Every themed brush
         reference that must update at runtime uses DynamicResource. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <Color x:Key="Background">#0F1113</Color>
    <Color x:Key="Surface">#171A1E</Color>
    <Color x:Key="SurfaceRaised">#1F2329</Color>
    <Color x:Key="Border">#2A2F36</Color>
    <Color x:Key="Text">#E8EAED</Color>
    <Color x:Key="TextSecondary">#B8BDC4</Color>
    <Color x:Key="Accent">#3EC6B8</Color>
    <Color x:Key="AccentSoft">#1C3632</Color>
    <Color x:Key="AccentInk">#3EC6B8</Color>
    <Color x:Key="Warning">#E8B34B</Color>
    <Color x:Key="WarningSoft">#3A2F1B</Color>
    <Color x:Key="Danger">#E86A6A</Color>
    <Color x:Key="Info">#8AA8C8</Color>
    <!-- High-contrast foregrounds for accent fills (handoff §4: never
         assume white-on-teal). Dark teal takes near-black text. -->
    <Color x:Key="OnAccent">#0B1210</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaised}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInk}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}"/>
</ResourceDictionary>
